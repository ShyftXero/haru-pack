   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At run the launcher scans backward for the footer, verifies the payload and stub-config against the footer's sha256, extracts to a per-user cache, materialises .haru-links as symlinks, seals .stage-files, then `uv run --offline` from vendor/cache. Nothing downloads.",
   "originalText": "At run the launcher scans backward for the footer, verifies the payload and stub-config against the footer's sha256, extracts to a per-user cache, materialises .haru-links as symlinks, seals .stage-files, then `uv run --offline` from vendor/cache. Nothing downloads.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
